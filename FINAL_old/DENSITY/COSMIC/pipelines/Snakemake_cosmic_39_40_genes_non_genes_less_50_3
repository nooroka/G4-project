            thresh=THRESH, genetype=GENETYPE
        ),
        expand(
            "../final_cosmic2/genes_non_genes/{thresh}/final/mutdensgene_non_quadr{thresh}_2-from_all_loop7_{genetype}_less_50_v11-3.txt",
            thresh=THRESH, genetype=GENETYPE
        ),
        expand(
            "../final_cosmic2/genes_non_genes/{thresh}/mutdensgene_quadr{thresh}_2_{number}_all_loop7_{genetype}_less_50_v11-3.txt",
            thresh=THRESH, genetype=GENETYPE, number=SAMPLES
        ),
        expand(
            "../final_cosmic2/genes_non_genes/{thresh}/mutdensgene_non_quadr{thresh}_2_{number}_all_loop7_{genetype}_less_50_v11-3.txt",
            thresh=THRESH, genetype=GENETYPE, number=SAMPLES
