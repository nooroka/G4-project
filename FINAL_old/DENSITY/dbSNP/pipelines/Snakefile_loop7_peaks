VERSIONS = ["39", "40"]

rule all:
     input:
        expand("../densities11_final/densities_peaks_{version}_percent-1209.txt", version=VERSIONS)

rule script2:
     input:
        "../../../punkt1/GSM/GSM_hg196_un_{number3}_{version}_my.bed",
