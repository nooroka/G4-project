         """
	 python ../scripts/script2_hg19_quadr_and_hg19_and_peaks.py {input} {wildcards.number3} {output}
         """

rule cat2:
     input:
        expand("../densities11/densities_peaks_{{version}}_percent{number3}-1209.txt", number3=SAMPLES)
