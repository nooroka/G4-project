rule split2:
    input:
        "../../GSM3003540/GSM3003540_quadr_7_6_2_minus3.bed"
    output:
        "../../GSM/GSM_hg196_40_my_minus.bed"
    shell:
        """
        python ../scripts/split2.py {input} {output}
        """

rule uniq:
    input:
        rules.split2.output
    output:
        "../../GSM/GSM_hg196_un_40_my_minus.bed"
    shell:
        "uniq {input} > {output}"

rule sp31:
    input:
        rules.uniq.output
    output:
        "../../GSM/GSM_hg196_un_{number}_40_my_minus.bed"
    shell:
        """
        python ../scripts/split3.py {input} {output} {wildcards.number}
        """
