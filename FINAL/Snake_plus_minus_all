rule sortrunnew55:
    input:
        x1 = "../gccoords/def/gccoords_{number}2defhg19_{version}_all_loop7_control2_no_gc_{strand}_corrected2.bed.gz",
        x2 = COSMIC_DIR + "/chr{number}_coordinates_shifted_tab_hgvsg_new_no_header.bed"
    output:
        "../mutdensgene_{version}_v13/mutdensgene_non_quadr{version}_2_{number}_all_loop7_control2_no_gc_v13-3_{strand}.txt"
