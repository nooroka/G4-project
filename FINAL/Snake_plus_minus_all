rule cat:
    input:
        x1 = expand(
            "../mutdensgene_{{version}}_v13/mutdensgene_quadr{{version}}_2_{number}_all_loop7_control2_no_gc_v13-3_{{strand}}.txt",
            number=SAMPLES
        ),
        x2 = expand(
            "../mutdensgene_{{version}}_v13/mutdensgene_non_quadr{{version}}_2_{number}_all_loop7_control2_no_gc_v13-3_{{strand}}.txt",
            number=SAMPLES
        )
    output:
        y1 = "final_cosmic/{version}/mutdensgene_quadr{version}_2-from_all_loop7_control2_no_gc_v13-3_{strand}.txt",
        y2 = "final_cosmic/{version}/mutdensgene_non_quadr{version}_2-from_all_loop7_control2_no_gc_v13-3_{strand}.txt"
    shell:
        """
        cat {input.x1} > {output.y1}
        cat {input.x2} > {output.y2}
        """


rule density:
    input:
        x1 = "final_cosmic/{version}/mutdensgene_quadr{version}_2-from_all_loop7_control2_no_gc_v13-3_{strand}.txt",
        x2 = "final_cosmic/{version}/mutdensgene_non_quadr{version}_2-from_all_loop7_control2_no_gc_v13-3_{strand}.txt"
    output:
        y1 = "final_cosmic/{version}/out_control2_no_gc_{version}_quadr_{strand}.csv",
        y2 = "final_cosmic/{version}/out_control2_no_gc_{version}_non-quadr_{strand}.csv"
    shell:
        """
        python ../scripts/density_per_ch_chunks.py {input.x1} {output.y1}
        python ../scripts/density_per_ch_chunks.py {input.x2} {output.y2}
        """
