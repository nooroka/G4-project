SAMPLES = [str(i) for i in range(1, 25)]
NUMS = ["39", "40"]

rule all:
    input:
        expand("../final_cosmic4/control1_with_gc/{n}/final/mutdensgene_quadr{n}_2-from_all_loop7_control1_v10-3.txt", n=NUMS),
        expand("../final_cosmic4/control1_with_gc/{n}/final/mutdensgene_non_quadr{n}_2-from_all_loop7_control1_v10-3.txt", n=NUMS),
        expand("../final_cosmic4/control1_with_gc/{n}/mutdensgene_quadr{n}_2_{number}_all_loop7_control1_v10-3.txt", n=NUMS, number=SAMPLES),
        expand("../final_cosmic4/control1_with_gc/{n}/mutdensgene_non_quadr{n}_2_{number}_all_loop7_control1_v10-3.txt", n=NUMS, number=SAMPLES),
        expand("../final_cosmic4/control1_with_gc/{n}/final/out_control1_{n}_quadr.csv", n=NUMS),
        expand("../final_cosmic4/control1_with_gc/{n}/final/out_control1_{n}_non-quadr.csv", n=NUMS)


rule sortrunnew5:
    input:
        x1 = "/data/nooroka/grant/punkt1/stage2/merged/quadr7_chain180424_merged2_sorted_{number}_{n}.bed",
        x2 = "/mnt/work/nooroka/punkt2/COSMIC_102/chr{number}_coordinates_shifted_tab_hgvsg_new_no_header.bed"
    output:
        "../final_cosmic4/control1_with_gc/{n}/mutdensgene_quadr{n}_2_{number}_all_loop7_control1_v10-3.txt"
    shell:
        "bash ../scripts/sortrunnew5-3-6.sh {input.x1} {input.x2} {output}"


rule sortrunnew55:
    input:
        x1 = "../gccoords2/def/gccoords_{number}2defhg19_{n}_all_loop7_with_gc_control1_corrected.bed.gz",
        x2 = "/mnt/work/nooroka/punkt2/COSMIC_102/chr{number}_coordinates_shifted_tab_hgvsg_new_no_header.bed"
    output:
        "../final_cosmic4/control1_with_gc/{n}/mutdensgene_non_quadr{n}_2_{number}_all_loop7_control1_v10-3.txt"
    shell:
        "bash ../scripts/sortrunnew55-3-6.sh <(zcat {input.x1}) {input.x2} {output}"


rule cat:
    input:
        x1 = lambda wc: expand(
            "../final_cosmic4/control1_with_gc/{n}/mutdensgene_quadr{n}_2_{number}_all_loop7_control1_v10-3.txt",
            n=wc.n, number=SAMPLES
        ),
        x2 = lambda wc: expand(
            "../final_cosmic4/control1_with_gc/{n}/mutdensgene_non_quadr{n}_2_{number}_all_loop7_control1_v10-3.txt",
            n=wc.n, number=SAMPLES
        )
    output:
        y1 = "../final_cosmic4/control1_with_gc/{n}/final/mutdensgene_quadr{n}_2-from_all_loop7_control1_v10-3.txt",
        y2 = "../final_cosmic4/control1_with_gc/{n}/final/mutdensgene_non_quadr{n}_2-from_all_loop7_control1_v10-3.txt"
    shell:
        """
        cat {input.x1} > {output.y1}
        cat {input.x2} > {output.y2}
        """


rule density:
    input:
        x1 = "../final_cosmic4/control1_with_gc/{n}/final/mutdensgene_quadr{n}_2-from_all_loop7_control1_v10-3.txt",
        x2 = "../final_cosmic4/control1_with_gc/{n}/final/mutdensgene_non_quadr{n}_2-from_all_loop7_control1_v10-3.txt"
    output:
        y1 = "../final_cosmic4/control1_with_gc/{n}/final/out_control1_{n}_quadr.csv",
        y2 = "../final_cosmic4/control1_with_gc/{n}/final/out_control1_{n}_non-quadr.csv"
    shell:
        """
        python ../scripts/density_per_ch_chunks2.py {input.x1} {output.y1}
        python ../scripts/density_per_ch_chunks2.py {input.x2} {output.y2}
        """
