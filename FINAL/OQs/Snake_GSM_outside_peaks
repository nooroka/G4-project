rule split2:
    input:
        "../../quadr_long_not_in_peaks.bed"
    output:
        "../../GSM/quadr_long_not_in_peaks_redone_my.bed"
    shell:
        """
        python ../scripts/count.py {input} {output}
        """

rule uniq:
    input:
        rules.split2.output
    output:
        "../../GSM/quadr_long_not_in_peaks_redone_my_un.bed"
    shell:
        "bedtools sort -i {input} | bedtools merge > {output}"
rule merge_and_sort:
     input:
        rules.uniq.output
     output:
        presorted = "../check/quadr_long_not_in_peaks_redone_my_un_flanks_presorted.bed",
        merged    = "../check/quadr_long_not_in_peaks_redone_my_un_flanks_presorted_merged.bed",
        sorted    = "../merged/quadr_long_not_in_peaks_redone_my_un_flanks_sorted_merged.bed"
     shell:
        """
        bedtools sort -i {input} > {output.presorted}
        bash ../scripts/merge.sh {output.presorted} {output.merged}
        bedtools sort -i {output.merged} > {output.sorted}
        """

