SAMPLES = [str(i) for i in range(1, 25)]
SIGN = ["plus", "minus"]

rule all:
    input:
        expand("../mutdensgene_39_v11/final/mutdensgene_quadr2-from_all_loop7_genes_39_v11-3_{sign}.txt", sign=SIGN),
        expand("../mutdensgene_39_v11/mutdensgene_quadr2_{number}_all_loop7_genes_39_v11-3_{sign}.txt",
               number=SAMPLES, sign=SIGN),
        expand("../mutdensgene_39_v11/final/out_genes_quadr_{sign}.csv", sign=SIGN)


rule sortrunnew5:
    input:
        x1 = "../../../punkt1/genes_{sign}/chr{number}_genes_{sign}.bed.gz",
        x2 = "/mnt/work/nooroka/punkt2/COSMIC_102/chr{number}_coordinates_shifted_tab_hgvsg_new_no_header.bed"
    output:
        "../mutdensgene_39_v11/mutdensgene_quadr2_{number}_all_loop7_genes_39_v11-3_{sign}.txt"
    shell:
        "bash ../scripts/sortrunnew5-3_genes.sh <(zcat {input.x1}) {input.x2} {output}"


rule cat:
    input:
        lambda wildcards: expand(
            "../mutdensgene_39_v11/mutdensgene_quadr2_{number}_all_loop7_genes_39_v11-3_{sign}.txt",
            number=SAMPLES,
            sign=wildcards.sign
        )
    output:
        "../mutdensgene_39_v11/final/mutdensgene_quadr2-from_all_loop7_genes_39_v11-3_{sign}.txt"
    shell:
        "cat {input} > {output}"


rule density:
    input:
        "../mutdensgene_39_v11/final/mutdensgene_quadr2-from_all_loop7_genes_39_v11-3_{sign}.txt"
    output:
        "../mutdensgene_39_v11/final/out_genes_quadr_{sign}.csv"
    shell:
        "python ../scripts/density_per_ch.py {input} {output}"
